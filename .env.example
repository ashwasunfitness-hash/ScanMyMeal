# Supabase public project settings (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only. Never expose or prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# Server-only meal analysis provider
AI_ANALYSIS_ENDPOINT=
AI_API_KEY=

# Local development only. Never enable in production.
ALLOW_DEMO_ANALYSIS=true
